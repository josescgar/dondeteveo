<?xml version="1.0" encoding="UTF-8"?>
<!-- A loop course exported as both a track and a route: joining them would double the length. -->
<gpx version="1.1" creator="fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>Loop</name>
    <trkseg>
      <trkpt lat="40.400" lon="-3.700" />
      <trkpt lat="40.401" lon="-3.700" />
      <trkpt lat="40.401" lon="-3.701" />
      <trkpt lat="40.400" lon="-3.701" />
      <trkpt lat="40.400" lon="-3.700" />
    </trkseg>
  </trk>
  <rte>
    <name>Loop</name>
    <rtept lat="40.400" lon="-3.700" />
    <rtept lat="40.401" lon="-3.700" />
    <rtept lat="40.401" lon="-3.701" />
    <rtept lat="40.400" lon="-3.701" />
    <rtept lat="40.400" lon="-3.700" />
  </rte>
</gpx>
