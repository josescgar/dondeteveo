---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { ProvisionalNotice } from "../../../../components/ProvisionalNotice";
import RaceMapIsland from "../../../../features/race-map/RaceMapIsland";
import SharePlannerIsland from "../../../../features/share-planner/SharePlannerIsland";

import { type Locale, SUPPORTED_LOCALES } from "../../../../lib/config";
import {
  buildRaceInfoFields,
  fillTemplate,
  formatDistance,
  formatRaceDate,
} from "../../../../lib/format";
import { buildRacePath } from "../../../../lib/routes";
import { getDictionary } from "../../../../lib/i18n";
import { getAllRaceEditions } from "../../../../lib/races/catalog";
import {
  buildEditionDescription,
  buildEditionFaq,
  buildEditionTitle,
  buildStartTimeRows,
} from "../../../../lib/races/edition-page";
import {
  getRelatedEditions,
  getSiblingEditions,
  isUpcomingEdition,
} from "../../../../lib/races/editions";
import { localizeRaceEdition } from "../../../../lib/races/localized";
import {
  getCheerPoints,
  getPointSummaries,
} from "../../../../lib/races/points";
import { getProvisionalFacts } from "../../../../lib/races/provisional";
import { buildEditionStructuredData } from "../../../../lib/structured-data";

export const getStaticPaths = async () => {
  const editions = await getAllRaceEditions();
  // One reference date for the whole build, so "past" and "upcoming" are
  // decided once and every page agrees.
  const buildDate = new Date();
  return SUPPORTED_LOCALES.flatMap((locale) =>
    editions.map((edition) => ({
      params: {
        locale,
        race: edition.raceSlug,
        year: edition.year,
      },
      props: {
        edition,
        allEditions: editions,
        buildDate,
      },
    })),
  );
};

const locale = Astro.params.locale as Locale;
const dictionary = getDictionary(locale);
const strings = dictionary.editionPage;
const { edition: rawEdition, allEditions, buildDate } = Astro.props;
const edition = localizeRaceEdition(rawEdition, locale);
const points = getPointSummaries(edition.points);
const cheerPoints = getCheerPoints(edition.points);
const provisionalFacts = getProvisionalFacts(edition.meta.provisional);
const pathname = buildRacePath(locale, edition.raceSlug, edition.year);
const raceInfoFields = buildRaceInfoFields(
  edition.meta,
  {
    date: dictionary.date,
    city: dictionary.city,
    startTime: dictionary.startTime,
  },
  locale,
);
const upcoming = isUpcomingEdition(edition, buildDate);
const title = buildEditionTitle(
  { name: edition.meta.name, year: edition.year },
  strings,
);
const description = buildEditionDescription(
  { meta: edition.meta, cheerPointCount: cheerPoints.length, locale },
  strings,
);
const startTimeRows = buildStartTimeRows(edition.meta, dictionary.startTime);
const faq = buildEditionFaq(
  {
    meta: edition.meta,
    year: edition.year,
    cheerPoints,
    upcoming,
    locale,
  },
  strings,
);

const { siblings, upcomingPointer } = getSiblingEditions(
  allEditions,
  rawEdition,
  buildDate,
);
const toEditionLink = (target: (typeof allEditions)[number]) => {
  const localized = localizeRaceEdition(target, locale);
  return {
    href: buildRacePath(locale, target.raceSlug, target.year),
    name: localized.meta.name,
    city: localized.meta.city,
    year: target.year,
    date: formatRaceDate(target.meta.date, locale),
    distance: formatDistance(target.meta.distanceKm, locale),
  };
};
const siblingLinks = siblings.map(({ edition: sibling, upcoming }) => ({
  ...toEditionLink(sibling),
  upcoming,
}));
const upcomingPointerLink = upcomingPointer
  ? toEditionLink(upcomingPointer)
  : undefined;
const relatedLinks = getRelatedEditions(allEditions, rawEdition, buildDate).map(
  toEditionLink,
);

const headingClass =
  "text-muted font-mono text-[10px] font-normal tracking-[0.28em] uppercase before:content-['//_']";
const rowClass =
  "border-line flex items-baseline justify-between gap-4 border-b py-2.5 font-mono text-sm";
const linkRowClass =
  "group border-line hover:bg-surface flex items-center justify-between gap-4 border-b py-3 pr-2 font-mono text-sm transition-colors";
---

<BaseLayout
  locale={locale}
  pathname={pathname}
  title={title}
  description={description}
  jsonLd={buildEditionStructuredData(locale, edition)}
  eyebrow={dictionary.raceDiscovery}
>
  <section class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
    <div class="space-y-5">
      <div class="text-muted font-mono text-[10px] tracking-[0.32em] uppercase">
        {edition.year} — {formatDistance(edition.meta.distanceKm, locale)}
      </div>
      <h1
        class="font-display text-accent leading-none font-bold uppercase"
        style="font-size: clamp(2.5rem, 8vw, 5.5rem);"
      >
        {edition.meta.name}
      </h1>
      <p class="text-muted font-mono text-sm leading-7">
        {edition.meta.summary}
      </p>
      {upcomingPointerLink && (
        <a
          href={upcomingPointerLink.href}
          class="group border-accent bg-accent-dim hover:bg-surface block border px-4 py-3.5 transition-colors sm:px-5"
          data-upcoming-edition-pointer
        >
          <span class="text-accent block font-mono text-[10px] tracking-[0.28em] uppercase">
            // {dictionary.upcomingEdition}
          </span>
          <span class="text-muted mt-2 block font-mono text-sm leading-6">
            {strings.pastEditionNotice}
          </span>
          <span class="text-text mt-1 block font-mono text-sm leading-6 font-bold">
            {fillTemplate(strings.viewEdition, {
              year: upcomingPointerLink.year,
            })}{" "}
            ({upcomingPointerLink.date}){" "}
            <span class="text-accent inline-block transition-transform group-hover:translate-x-0.5">
              →
            </span>
          </span>
        </a>
      )}
      {provisionalFacts.length > 0 && (
        <ProvisionalNotice locale={locale} facts={provisionalFacts} />
      )}
      {edition.meta.specialNote && (
        <div class="banner-warning">
          <div class="text-warning font-mono text-[10px] tracking-[0.28em] uppercase">
            // {dictionary.importantRaceNote}
          </div>
          <p class="text-text mt-3 font-mono text-sm leading-6">
            {edition.meta.specialNote}
          </p>
        </div>
      )}
      <dl
        class="border-line m-0 grid gap-3 overflow-hidden border px-4 py-3.5 sm:px-5 md:grid-cols-3 md:gap-4"
        data-race-info-grid
      >
        {raceInfoFields.map(({ label, value }) => (
          <div class="flex min-w-0 flex-col gap-2" data-race-info-field>
            <dt class="text-accent m-0 font-mono text-[10px] tracking-[0.26em] uppercase">
              {label}
            </dt>
            <dd class="text-text m-0 min-w-0 font-mono text-sm leading-6 [overflow-wrap:anywhere]">
              {value}
            </dd>
          </div>
        ))}
      </dl>
      <a
        href={edition.meta.officialWebsiteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted hover:text-accent inline-flex font-mono text-sm tracking-[0.18em] uppercase transition"
        data-official-website
      >
        {dictionary.officialWebsite} ↗
      </a>
    </div>

    <SharePlannerIsland
      locale={locale}
      raceSlug={edition.raceSlug}
      year={edition.year}
      waves={edition.meta.waves}
      {...(provisionalFacts.length > 0 ? { provisionalFacts } : {})}
      client:load
    />
  </section>

  <section class="mt-10 grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
    <RaceMapIsland
      locale={locale}
      route={edition.route}
      points={edition.points}
      raceDistanceKm={edition.meta.distanceKm}
      mode="distance-only"
      client:visible
    />
    <div data-edition-section="route">
      <h2 class={headingClass}>{dictionary.routeOverview}</h2>
      <p class="text-muted mt-3 font-mono text-sm leading-6">
        {edition.meta.heroNote}
      </p>
      <div class="mt-5">
        {points.map((point) => (
          <div class="border-line flex items-center justify-between gap-4 border-b py-2.5 font-mono text-sm">
            <span class="text-muted min-w-0 [overflow-wrap:anywhere]">
              {point.properties.label}
            </span>
            <span class="text-accent shrink-0">
              {formatDistance(point.properties.distanceKm, locale)}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mt-10 grid gap-10 lg:grid-cols-2 lg:gap-6">
    <div class="space-y-10">
      <div data-edition-section="where-to-watch">
        <h2 class={headingClass}>{strings.whereToWatchHeading}</h2>
        {cheerPoints.length > 0 ? (
          <>
            <p class="text-muted mt-3 font-mono text-sm leading-6">
              {strings.whereToWatchIntro}
            </p>
            <ul class="m-0 mt-4 list-none p-0">
              {cheerPoints.map((point) => (
                <li class={rowClass}>
                  <span class="text-text min-w-0 [overflow-wrap:anywhere]">
                    {point.properties.label}
                  </span>
                  <span class="text-accent shrink-0">
                    {formatDistance(point.properties.distanceKm, locale)}
                  </span>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <p class="text-muted mt-3 font-mono text-sm leading-6">
            {strings.whereToWatchFallback}
          </p>
        )}
      </div>

      <div data-edition-section="start-times">
        <h2 class={headingClass}>{strings.startTimesHeading}</h2>
        <p class="text-muted mt-3 font-mono text-sm leading-6">
          {fillTemplate(strings.startTimesNote, {
            timezone: edition.meta.timezone,
          })}
        </p>
        <ul class="m-0 mt-4 list-none p-0">
          {startTimeRows.map((row) => (
            <li class={rowClass} data-start-time-row>
              <span class="text-text min-w-0 [overflow-wrap:anywhere]">
                {row.label}
              </span>
              <time class="text-accent shrink-0" datetime={row.startTime}>
                {row.startTime}
              </time>
            </li>
          ))}
        </ul>
        {provisionalFacts.includes("startTime") && (
          <p class="text-warning mt-3 font-mono text-xs leading-5">
            {dictionary.provisionalStartTimeNotice}
          </p>
        )}
      </div>
    </div>

    <div data-edition-section="faq">
      <h2 class={headingClass}>{strings.faqHeading}</h2>
      <div class="mt-4">
        {faq.map((item) => (
          <div class="border-line border-b py-3.5">
            <h3 class="text-text m-0 font-mono text-sm leading-6 font-bold">
              {item.question}
            </h3>
            <p class="text-muted mt-1.5 font-mono text-sm leading-6">
              {item.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {(siblingLinks.length > 0 || relatedLinks.length > 0) && (
    <section class="mt-10 grid gap-10 lg:grid-cols-2 lg:gap-6">
      {siblingLinks.length > 0 && (
        <nav
          aria-labelledby="other-editions-heading"
          data-edition-section="other-editions"
        >
          <h2 id="other-editions-heading" class={headingClass}>
            {strings.otherEditionsHeading}
          </h2>
          <ul class="m-0 mt-4 list-none p-0">
            {siblingLinks.map((link) => (
              <li>
                <a href={link.href} class={linkRowClass}>
                  <span class="flex min-w-0 items-center gap-3">
                    <span
                      class={`w-0.5 shrink-0 self-stretch ${link.upcoming ? "bg-accent" : "bg-line-solid"}`}
                    />
                    <span class="min-w-0">
                      <span class="text-text block font-bold">{link.year}</span>
                      <span class="text-muted block text-xs">{link.date}</span>
                    </span>
                  </span>
                  <span class="flex shrink-0 items-center gap-3 text-xs">
                    <span
                      class={`bg-surface-raised px-2 py-0.5 text-[10px] tracking-wider ${link.upcoming ? "text-accent" : "text-muted"}`}
                    >
                      {link.upcoming
                        ? dictionary.upcomingEdition
                        : dictionary.pastEdition}
                    </span>
                    <span class="text-accent transition-transform group-hover:translate-x-0.5">
                      →
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      {relatedLinks.length > 0 && (
        <nav
          aria-labelledby="more-races-heading"
          data-edition-section="more-races"
        >
          <h2 id="more-races-heading" class={headingClass}>
            {strings.moreRacesHeading}
          </h2>
          <p class="text-muted mt-3 font-mono text-sm leading-6">
            {strings.moreRacesIntro}
          </p>
          <ul class="m-0 mt-4 list-none p-0">
            {relatedLinks.map((link) => (
              <li>
                <a href={link.href} class={linkRowClass}>
                  <span class="min-w-0">
                    <span class="text-text block font-bold [overflow-wrap:anywhere]">
                      {link.name} {link.year}
                    </span>
                    <span class="text-muted block text-xs">
                      {link.city} · {link.date} · {link.distance}
                    </span>
                  </span>
                  <span class="text-accent shrink-0 transition-transform group-hover:translate-x-0.5">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </section>
  )}
</BaseLayout>
