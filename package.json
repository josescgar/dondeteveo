{
  "name": "dondeteveo",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "check": "astro check",
    "data:rollover": "node scripts/rollover-edition.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "data:import": "node scripts/import-route.ts",
    "data:validate": "node scripts/validate-editions.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "leaflet": "^1.9.4",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.23",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
